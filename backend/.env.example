ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
PAYJP_SECRET_KEY=sk_test_xxxxxxxx
TOKEN_SECRET=your-random-secret
FRONTEND_URL=https://your-vercel-app.vercel.app
PORT=3001
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# 本番は true。ローカルでゲスト導線を確認するときだけ false にする。
REQUIRE_READING_AUTH=true
AI_REPORT_ENABLED=true
# 0 にすると旧キャッシュキーへ即時ロールバックする。
AI_CACHE_KEY_V2=1
# 1カードのAI整文タイムアウト（ms）。既定値: 60000
AI_REPORT_TIMEOUT_MS=60000
# 1レポート全体のAI整文タイムアウト（ms）。既定値: 100000
AI_REPORT_TOTAL_TIMEOUT_MS=100000
# AIカードの最大並列生成数。既定値: 4
AI_REPORT_MAX_CONCURRENCY=4
# AI整文の原価安全装置。上限後は決定論カードを返す。
AI_DAILY_CARD_LIMIT=500
AI_MAX_CARDS_PER_REPORT=25
# 決定論化は初回ローンチでは本番接続しない。空文字が既定値。
DETERMINISTIC_SCOPE=
# シャドー計測を有効にする場合だけ1。既定値: 無効
SHADOW_METRICS=0
FREE_QUESTION_LIMIT=2
READING_QUESTION_RATE_LIMIT=6
PREVIEW_QUESTION_RATE_LIMIT=6
# 有料ユーザー1人あたりの月間AI質問上限。既定値: 100
PREMIUM_MONTHLY_QUESTION_LIMIT=100
# 全ユーザー合計の月間AI質問上限。既定値: 5000
AI_CHAT_MONTHLY_GLOBAL_LIMIT=5000
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
# 旧Web課金を有効にする環境だけ設定。既定値は右記のID。
PAYJP_PLAN_LIGHT=fortune_light
PAYJP_PLAN_STANDARD=fortune_standard
PAYJP_PLAN_HEAVY=fortune_heavy
APPLE_BUNDLE_ID=com.onsai.fatelab
APPLE_APP_ID=6801998916
APPLE_SUBSCRIPTION_PRODUCT_ID=com.onsai.fatelab.premium.monthly
# Sign in with Apple のトークン失効用。秘密鍵の改行は \\n で保存する。
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_SIGN_IN_KEY_ID=XXXXXXXXXX
APPLE_SIGN_IN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# Apple Root CA certificates (DER), Base64 encoded and comma-separated.
APPLE_ROOT_CA_BASE64=base64-encoded-der-certificates

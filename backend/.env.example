ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
PAYJP_SECRET_KEY=sk_test_xxxxxxxx
TOKEN_SECRET=your-random-secret
FRONTEND_URL=https://your-vercel-app.vercel.app
PORT=3001
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
# 本番は true。ローカルでゲスト導線を確認するときだけ false にする。
REQUIRE_READING_AUTH=true
AI_REPORT_ENABLED=true
# 0 にすると旧キャッシュキーへ即時ロールバックする。
AI_CACHE_KEY_V2=1
# AI整文の原価安全装置。上限後は決定論カードを返す。
AI_DAILY_CARD_LIMIT=500
AI_MAX_CARDS_PER_REPORT=25
FREE_QUESTION_LIMIT=2
READING_QUESTION_RATE_LIMIT=6
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
STRIPE_PRICE_ID=price_xxxxxxxxxxxxxxxxxxxx
APPLE_BUNDLE_ID=com.onsai.fatelab
APPLE_APP_ID=6801998916
APPLE_SUBSCRIPTION_PRODUCT_ID=com.onsai.fatelab.premium.monthly
# Apple Root CA certificates (DER), Base64 encoded and comma-separated.
APPLE_ROOT_CA_BASE64=base64-encoded-der-certificates

          ]
        },
        {
          "id": "SY12-006",
          "family": "shukuyo",
          "key": "角宿",
          "scope": "common",
          "scopeBasis": "gender_scope",
          "exclusionReasons": [],
          "text": "関心を持ったことには、行動へ移るのが早い。",
          "urls": [
            "https://kosei-do.co.jp/sukuyo/work.php?yado_no=12"
          ]
        },
        {
          "id": "SY12-016",
          "family": "shukuyo",
          "key": "角宿",
          "scope": "common",
          "scopeBasis": "gender_scope",
          "exclusionReasons": [],
          "text": "好みがはっきりしていて、気の進まないことへ柔軟に対応しにくい。",
          "urls": [
            "https://kosei-do.co.jp/sukuyo/work.php?yado_no=12"
          ]
        },
        {
          "id": "SY12-033",
          "family": "shukuyo",
          "key": "角宿",
          "scope": "common",
          "scopeBasis": "gender_scope",
          "exclusionReasons": [],
          "text": "夢中になりながら、現状をよくする視点も持つ。",
          "urls": [
            "https://kosei-do.co.jp/sukuyo/gaiyou.php?yado_no=12"
          ]
        },
        {
          "id": "SY12-038",
          "family": "shukuyo",
          "key": "角宿",
          "scope": "common",
          "scopeBasis": "gender_scope",
          "exclusionReasons": [],
          "text": "興味が湧くと、長く考える前に動く。",
          "urls": [
            "https://kosei-do.co.jp/sukuyo/work.php?yado_no=12"
          ]
        },
        {
          "id": "SY12-039",
          "family": "shukuyo",
          "key": "角宿",
          "scope": "common",
          "scopeBasis": "gender_scope",
          "exclusionReasons": [],
          "text": "好き嫌いの強さが、融通の利かなさにつながる。",
          "urls": [
            "https://kosei-do.co.jp/sukuyo/work.php?yado_no=12"
          ]
        },
        {
          "id": "SY12-044",
          "family": "shukuyo",
          "key": "角宿",
          "scope": "common",
          "scopeBasis": "gender_scope",
          "exclusionReasons": [],

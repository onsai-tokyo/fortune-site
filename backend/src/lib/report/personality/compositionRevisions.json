          "reviewId": "personal-material-20260924:mansion"
        },
        {
          "id": "material:shukuyo:角宿:02:detail",
          "text": "人や物事の噂より、裏付けを求める面があります。",
          "refs": [
            "SY12-044"
          ],
          "kind": "astrological_interpretation",
          "scope": "common",
          "owner": {
            "family": "shukuyo",
            "key": "角宿"
          },
          "reviewStatus": "material_reviewed",
          "withheldReasons": [],
          "reviewId": "personal-material-20260924:mansion"
        },
        {
          "id": "material:shukuyo:角宿:02:tension",
          "text": "好き嫌いがはっきりしていて、気の進まないことには柔軟に対応しにくいところがあります。",

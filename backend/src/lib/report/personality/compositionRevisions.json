          },
          "reviewStatus": "material_reviewed",
          "withheldReasons": [],
          "reviewId": "personal-material-20260924:mansion"
        },
        {
          "id": "material:shukuyo:房宿:09:detail",
          "text": "自分が尽くす分、相手からも同じだけの応答を受けたいと望みます。",

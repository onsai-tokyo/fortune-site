      "conditions": {
        "dayPillar": "丁卯",
        "mansion": "角宿"
      },
      "sectionId": "02_考え方のくせ",
      "reason": "行動速度の相反する記述を性格の断定として併記せず、両方の読みと判定限界を一つの段落で示す。裏付けを求める具体的な行動を先頭にする。",
      "beforeParagraphs": [
        {
          "id": "material:day_pillar:丁卯:02:conclusion",
          "text": "すぐには動かず周囲を待たせても、十分に考えた後には、予想以上に大きな決断をすることがあります。",
          "refs": [
            "DP04-021"
          ],
          "kind": "astrological_interpretation",
          "scope": "common",
          "owner": {
            "family": "day_pillar",
            "key": "丁卯"
          },
          "reviewStatus": "material_reviewed",

          "reviewId": "personal-material-20260924:mansion"
        },
        {
          "id": "material:shukuyo:房宿:09:tension",
          "text": "親密になるほど、自分の好みや期待を強く求めることがあります。独占したい気持ちや嫉妬が強まりやすい面もあります。",
          "refs": [
            "SY15-006",
            "SY15-023",
            "SY15-035"
          ],
          "kind": "astrological_interpretation",
          "scope": "common",
          "owner": {
            "family": "shukuyo",
            "key": "房宿"
          },
          "reviewStatus": "material_reviewed",
          "withheldReasons": [],
          "reviewId": "personal-material-20260924:mansion"
        },
        {
          "id": "material:shukuyo:房宿:09:advice",
          "text": "疑いで見えにくくなった相手の長所へ、あらためて目を向けることを意識してみてください。",

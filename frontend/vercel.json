{
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://fortune-site-iuzo.onrender.com/api/:path*" },
    { "source": "/health", "destination": "https://fortune-site-iuzo.onrender.com/health" },
    { "source": "/lp", "destination": "/lp.html" },
    { "source": "/auth", "destination": "/app.html" },
    { "source": "/chat", "destination": "/app.html" },
    { "source": "/reading", "destination": "/app.html" },
    { "source": "/reading/:path*", "destination": "/app.html" },
    { "source": "/r/:path*", "destination": "/app.html" },
    { "source": "/s/:path*", "destination": "/app.html" },
    { "source": "/mypage", "destination": "/app.html" },
    { "source": "/me", "destination": "/app.html" },
    { "source": "/history/:path*", "destination": "/app.html" },
    { "source": "/payment/:path*", "destination": "/app.html" },
    { "source": "/result", "destination": "/app.html" },
    { "source": "/analyze", "destination": "/app.html" },
    { "source": "/compat-report", "destination": "/app.html" },
    { "source": "/feature/:path*", "destination": "/app.html" }
  ],
  "headers": [
    { "source": "/auth", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/chat", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/reading", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/reading/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/r/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/mypage", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/me", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/history/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/payment/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/result", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/analyze", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/compat-report", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/feature/:path*", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/lp", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/lp.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, follow" }] },
    { "source": "/debug.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/auto-test.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/final-check.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/simple-test.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/test-toast.html", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}

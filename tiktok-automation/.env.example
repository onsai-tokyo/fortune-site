# ========================================
# Fate Lab TikTok 自動化システム 設定ファイル
# このファイルを .env にコピーして値を入力してください
# cp .env.example .env
# ========================================

# Claude API キー（必須）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Buffer 設定（投稿自動化に必要）
# https://buffer.com/developers/api でアクセストークン取得
BUFFER_ACCESS_TOKEN=your_buffer_access_token_here
# Buffer のチャンネルID（TikTok・Instagramなどカンマ区切り）
# python post_scheduler.py を実行するとIDを確認できます
BUFFER_CHANNEL_IDS=tiktok_channel_id,instagram_channel_id

# VOICEVOX 設定（デフォルトのまま基本OK）
VOICEVOX_URL=http://localhost:50021
# スピーカーID: 1=四国めたん, 3=ずんだもん, 8=春日部つむぎ, 13=青山龍星(推奨)
VOICEVOX_SPEAKER_ID=13
VOICEVOX_SPEED=0.95
VOICEVOX_INTONATION=1.1

# 実行スケジュール（デーモンモード使用時）
RUN_HOUR=8
RUN_MINUTE=0

# 投稿予約時刻（TikTok ゴールデンタイム）
POST_HOUR=18
POST_MINUTE=0

# BGMファイルパス（任意・著作権フリーのものを用意して設定）
# BGM_PATH=assets/bgm/ambient.mp3
